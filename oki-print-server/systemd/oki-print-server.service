[Unit]
Description=OKI UDP and Web Print Server
After=network.target

[Service]
Type=simple
User=oki-print-server
Group=lp
ExecStart=/opt/oki-print-server/venv/bin/python /opt/oki-print-server/server.py --config /etc/oki-print-server/config.toml
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
